# Local PostgreSQL (service "postgresql-x64-17" is installed on this PC).
# Replace YOUR_PASSWORD with the postgres superuser password set during install,
# and make sure the whiteboard database exists (see README "Run on your PC").
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@127.0.0.1:5432/whiteboard

# Optional overrides
# PYTHON_BINARY=python
# PORT=3010